      <aliases enabled='yes' />
      <column caption='Complete Observation' datatype='string' name='[Calculation_0129513149587456]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF NOT ISNULL([Estimates, 1950 - 2020: Annually interpolated demographic indicators - Under-five mortality (deaths under age 5 per 1,000 live ])&#13;&#10;AND NOT ISNULL([Mean years of schooling, women (in reproductive age 15 to 49) (Our World In Data (2017))])&#13;&#10;THEN &quot;Complete&quot;&#13;&#10;ELSE &quot;Incomplete&quot;&#13;&#10;END' />
      </column>
      <column caption='Education Change' datatype='real' name='[Calculation_0129513149906947]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Entity] :&#13;&#10;    MAX(&#13;&#10;        IF [Year] = 2010&#13;&#10;        THEN [Mean years of schooling, women (in reproductive age 15 to 49) (Our World In Data (2017))]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}&#13;&#10;-&#13;&#10;{ FIXED [Entity] :&#13;&#10;    MAX(&#13;&#10;        IF [Year] = 1950&#13;&#10;        THEN [Mean years of schooling, women (in reproductive age 15 to 49) (Our World In Data (2017))]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
      </column>
      <column caption='Mortality 1950' datatype='real' name='[Calculation_0129513151143941]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Year] = 1950 THEN [Estimates, 1950 - 2020: Annually interpolated demographic indicators - Under-five mortality (deaths under age 5 per 1,000 live ] END' />
      </column>
      <column caption='Mortality 2010' datatype='real' name='[Calculation_0129513151238150]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Year] = 2010 THEN [Estimates, 1950 - 2020: Annually interpolated demographic indicators - Under-five mortality (deaths under age 5 per 1,000 live ] END' />
      </column>
      <column caption='Mortality Reduction' datatype='real' name='[Calculation_0129513151315975]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Entity] :&#13;&#10;    MAX(&#13;&#10;        IF [Year] = 1950&#13;&#10;        THEN [Estimates, 1950 - 2020: Annually interpolated demographic indicators - Under-five mortality (deaths under age 5 per 1,000 live ]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}&#13;&#10;-&#13;&#10;{ FIXED [Entity] :&#13;&#10;    MAX(&#13;&#10;        IF [Year] = 2010&#13;&#10;        THEN [Estimates, 1950 - 2020: Annually interpolated demographic indicators - Under-five mortality (deaths under age 5 per 1,000 live ]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
      </column>
      <column caption='Selected Year Filter' datatype='boolean' name='[Calculation_0129513151762441]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Year] = [Parameters].[Parameter 0129513149988868]' />
      </column>
      <column caption='Education Change 1950-2010' datatype='real' name='[Calculation_0129513151967243]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Entity] :&#13;&#10;    MAX(&#13;&#10;        IF [Year] = 2010&#13;&#10;        THEN [Mean years of schooling, women (in reproductive age 15 to 49) (Our World In Data (2017))]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}&#13;&#10;-&#13;&#10;{ FIXED [Entity] :&#13;&#10;    MAX(&#13;&#10;        IF [Year] = 1950&#13;&#10;        THEN [Mean years of schooling, women (in reproductive age 15 to 49) (Our World In Data (2017))]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
      </column>
      <column caption='Selected Country Filter' datatype='boolean' name='[Calculation_0129513152213004]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Entity]=[Parameters].[Parameter 0129513151852554]' />
      </column>
      <column caption='Education Level' datatype='string' name='[Calculation_0129513152339981]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Mean years of schooling, women (in reproductive age 15 to 49) (Our World In Data (2017))] &lt; 3 THEN &quot;Low&quot;&#13;&#10;ELSEIF [Mean years of schooling, women (in reproductive age 15 to 49) (Our World In Data (2017))] &lt; 6 THEN &quot;Medium&quot;&#13;&#10;ELSEIF [Mean years of schooling, women (in reproductive age 15 to 49) (Our World In Data (2017))] &lt; 9 THEN &quot;High&quot;&#13;&#10;ELSE &quot;Very High&quot;&#13;&#10;END' />
      </column>
      <column caption='Selected Year Display' datatype='string' name='[Calculation_0129513155850254]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([Parameters].[Parameter 0129513149988868])' />
      </column>
      <column caption='Morality Level' datatype='string' name='[Calculation_0129513160118288]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF AVG([Estimates, 1950 - 2020: Annually interpolated demographic indicators - Under-five mortality (deaths under age 5 per 1,000 live ]) &gt;= 20 THEN&#13;&#10;    &quot;High&quot;&#13;&#10;ELSEIF AVG([Estimates, 1950 - 2020: Annually interpolated demographic indicators - Under-five mortality (deaths under age 5 per 1,000 live ]) &gt;= 10 THEN&#13;&#10;    &quot;Medium&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Low&quot;&#13;&#10;END' />
      </column>
      <column caption='Under-5 Survival Rate' datatype='real' name='[Calculation_0129513163993105]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(1000 - [Estimates, 1950 - 2020: Annually interpolated demographic indicators - Under-five mortality (deaths under age 5 per 1,000 live ]) / 10' />
      </column>
